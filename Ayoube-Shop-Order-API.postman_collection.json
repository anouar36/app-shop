                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            },
            "description": "Creates an order for an authenticated user. Requires Authorization header. Automatically sends email notification to admin."
          },
          "response": []
