{
  "info": {
    "name": "Ayoube Shop - Order API with Email Notifications",
    "description": "E-commerce order API that automatically sends email notifications to admins",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "📧 Orders with Email Notifications",
      "description": "API endpoints for creating orders that trigger admin email notifications",
      "item": [
        {
          "name": "Create Guest Order (COD) - Sends Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"Ahmed\",\n  \"client_lastname\": \"Benali\",\n  \"email\": \"ahmed.benali@gmail.com\",\n  \"phone\": \"+212661234567\",\n  \"products_id\": 1,\n  \"method_payment\": \"cod\",\n  \"payment_method\": \"cod\",\n  \"address\": \"123 Rue Hassan II, Casablanca, Morocco\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            },
            "description": "Creates a guest order with Cash on Delivery payment. Automatically sends email notification to admin with customer and order details."
          },
          "response": []
        },
        {
