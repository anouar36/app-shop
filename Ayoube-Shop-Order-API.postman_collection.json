        {
          "name": "Create Authenticated User Order - Sends Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"Youssef\",\n  \"client_lastname\": \"Tazi\",\n  \"email\": \"youssef.tazi@yahoo.com\",\n  \"phone\": \"+212667891234\",\n  \"products_id\": 1,\n  \"method_payment\": \"cod\",\n  \"payment_method\": \"cod\",\n  \"address\": \"789 Boulevard Zerktouni, Marrakech, Morocco\"\n}",
              "options": {
